/**
 * THE BEAUTY METHOD — LIVE BOOKING WEB APP (backend)
 * ------------------------------------------------
 * SETUP:
 * 1. script.google.com → New Project. Paste this in as "Code.gs".
 * 2. Add a second file: File > New > HTML file, name it exactly "index"
 *    (not index.html — Apps Script adds the extension). Paste the other file's content in.
 * 3. Update OWNER_EMAIL below.
 * 4. Run "setupSheet" once (function dropdown > setupSheet > Run). Authorize when prompted.
 *    Existing sheet from the older version? Run "migrateSheet" once instead (safe to re-run).
 * 5. Deploy > New deployment > type "Web app".
 *    - Execute as: Me
 *    - Who has access: Anyone
 *    - Click Deploy, authorize again if asked.
 * 6. Copy the Web App URL it gives you — that's your "Book Now" link.
 * 7. Whenever you edit the code, you must create a NEW deployment version
 *    (Deploy > Manage deployments > pencil icon > New version) for changes to go live.
 */

const OWNER_EMAIL = 'bookings@beautymethodservices.com';
const SUPPORT_EMAIL = 'support@beautymethodservices.com'; // used as reply-to on client confirmations
// Must be added and verified as a "Send mail as" alias under whichever
// Google account this script is deployed/executed as (Gmail Settings ->
// Accounts and Import -> Send mail as). Using GmailApp instead of MailApp
// sends through the real authenticated mailbox, which external providers
// trust more than MailApp's shared relay.
const SEND_FROM_ALIAS = 'bookings@beautymethodservices.com';

const BRAND_NAME = 'The Beauty Method';
const INVITE_CLIENT_TO_CALENDAR = false; // salon calendar only; client gets the confirmation email

// Brand colors used in the confirmation email
const EMAIL_ACCENT = '#a6567f';

// ---------- SCHEDULING ----------
// Hours per day of week. Days not listed are closed.
// An appointment must FINISH by close (buffer after the last client isn't required).
const BUSINESS_HOURS = {
  'Monday':   { open: '10:00', close: '16:00' },
  'Saturday': { open: '10:00', close: '16:00' },
  'Sunday':   { open: '14:00', close: '16:00' }
};
const SLOT_INTERVAL_MINUTES = 30;   // spacing of start times offered to clients
const CLEANUP_BUFFER_MINUTES = 10;  // blocked after every appointment (set 0 to disable)
const MIN_APPOINTMENT_MINUTES = 30; // floor if selected services total less (e.g. add-ons only)
const LEGACY_ROW_MINUTES = 30;      // assumed length of old rows that have no duration saved
const BOOKING_WINDOW_DAYS = 30;

// Fixed-date holidays — recur every year. Format: 'MM-DD'
const FIXED_HOLIDAYS = ['01-01', '07-04', '12-24', '12-25', '12-31'];

// One-off closures. Format: 'YYYY-MM-DD'
const ONE_OFF_CLOSURES = [
  // '2026-11-26', // Thanksgiving 2026
];

// ---------- SERVICES ----------
