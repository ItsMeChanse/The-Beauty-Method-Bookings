// Columns A–H match the live sheet; I–J are new (appended so F/G don't move).
const SHEET_HEADERS = ['Timestamp','Full Name','Phone','Email','Services','Date','Time','Notes','Duration (min)','End Time'];
const COL = { DATE: 5, TIME: 6, DURATION: 8 }; // 0-based indexes into getValues() rows

// Logo used in confirmation emails, stored as base64 so no external hosting
// or Drive file permissions are needed.
const LOGO_BASE64 = '';

function getLogoBlob_() {
  const bytes = Utilities.base64Decode(LOGO_BASE64);
  return Utilities.newBlob(bytes, 'image/jpeg', 'logo.jpg');
}

// ---------- HELPERS ----------
function ownerEmail_()   { return OWNER_EMAIL   || Session.getEffectiveUser().getEmail(); }
function supportEmail_() { return SUPPORT_EMAIL || ownerEmail_(); }
function tz_()           { return Session.getScriptTimeZone(); }

function mailOpts_(opts) {
  if (SEND_FROM_ALIAS) opts.from = SEND_FROM_ALIAS;
  return opts;
}

// Client input goes into an HTML email — escape it so nobody can inject markup.
function esc_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// 45 -> "45 min", 60 -> "1 hr", 105 -> "1 hr 45 min"
function formatDuration_(mins) {
  const h = Math.floor(mins / 60), m = mins % 60;
  if (!h) return m + ' min';
  return h + ' hr' + (m ? ' ' + m + ' min' : '');
}

function serviceLabel_(item) { return item.name + ' — ' + item.price; }

// "10:30 AM" -> 630
function timeToMinutes_(t) {
  const m = String(t).trim().match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
  if (!m) return NaN;
  let h = Number(m[1]) % 12;
  if (m[3].toUpperCase() === 'PM') h += 12;
  return h * 60 + Number(m[2]);
}

// 630 -> "10:30 AM"
function minutesToTime_(mins) {
  const h = Math.floor(mins / 60), m = mins % 60;
  let h12 = h % 12; if (h12 === 0) h12 = 12;
  return h12 + ':' + (m < 10 ? '0' + m : m) + ' ' + (h >= 12 ? 'PM' : 'AM');
}

function hhmmToMinutes_(s) {
  const [h, m] = s.split(':').map(Number);
  return h * 60 + m;
}

// Sheets can auto-convert "10:30 AM" / "Monday, August 3" into Date values.
// Normalize back to the strings the app uses so comparisons always work.
function cellToTime_(v) {
  return v instanceof Date ? Utilities.formatDate(v, tz_(), 'h:mm a') : String(v).trim();
}
function cellToDate_(v) {
  return v instanceof Date ? Utilities.formatDate(v, tz_(), 'EEEE, MMMM d') : String(v).trim();
}

// Maps service ids ("sectionIdx-itemIdx") back to catalog items.
// The server computes the duration — the client's number is never trusted.
function resolveServices_(ids) {
  if (!Array.isArray(ids)) return null;
  const items = [];
  for (const id of ids) {
    const parts = String(id).split('-').map(Number);
    const sec = SERVICE_CATALOG[parts[0]];
    const item = sec && sec.items[parts[1]];
    if (!item) return null;
    items.push(item);
  }
  return items;
}

function totalMinutes_(items) {
  const sum = items.reduce((a, it) => a + (it.minutes || 0), 0);
  return Math.max(sum, MIN_APPOINTMENT_MINUTES);
}

// Existing bookings on a date as [{start, end}] in minutes-of-day.
function bookingsForDate_(data, date) {
  const out = [];
  for (let i = 1; i < data.length; i++) {
    if (cellToDate_(data[i][COL.DATE]) !== date) continue;
    const start = timeToMinutes_(cellToTime_(data[i][COL.TIME]));
    if (isNaN(start)) continue;
    const dur = Number(data[i][COL.DURATION]) || LEGACY_ROW_MINUTES;
    out.push({ start: start, end: start + dur });
  }
  return out;
}

// Both appointments get the cleanup buffer after them before anything else can start.
function overlaps_(start, end, bookings) {
  const buf = CLEANUP_BUFFER_MINUTES;
  return bookings.some(b => start < b.end + buf && b.start < end + buf);
}

// Every start time on a day, with whether a `duration`-minute appointment fits there.
function computeSlots_(date, duration, data) {
  const dayName = date.split(',')[0].trim();
  const hours = BUSINESS_HOURS[dayName];
  if (!hours) return [];
  const open = hhmmToMinutes_(hours.open);
  const close = hhmmToMinutes_(hours.close);
  const bookings = bookingsForDate_(data, date);

  // Don't offer times that have already passed today.
  const now = new Date();
  const isToday = Utilities.formatDate(now, tz_(), 'EEEE, MMMM d') === date;
  const nowMins = Number(Utilities.formatDate(now, tz_(), 'H')) * 60 + Number(Utilities.formatDate(now, tz_(), 'm'));

  const slots = [];
  for (let s = open; s + duration <= close; s += SLOT_INTERVAL_MINUTES) {
    if (isToday && s <= nowMins) continue;
    slots.push({ time: minutesToTime_(s), booked: overlaps_(s, s + duration, bookings) });
  }
  return slots;
}

function parseBookingDateTime_(dateStr, timeStr, durationMins) {
  const monthDay = dateStr.split(',')[1].trim();
  const now = new Date();
  const year = now.getFullYear();
  let start = new Date(monthDay + ', ' + year + ' ' + timeStr);

  const oneDayMs = 24 * 60 * 60 * 1000;
  if (start.getTime() < now.getTime() - oneDayMs) {
    start = new Date(monthDay + ', ' + (year + 1) + ' ' + timeStr);
  }
  const end = new Date(start.getTime() + durationMins * 60000);
  return { start: start, end: end };
}

// ---------- ONE-TIME SETUP ----------
function setupSheet() {
  const ss = SpreadsheetApp.create('Beauty Method — Live Bookings');
  const sheet = ss.getSheets()[0];
  sheet.appendRow(SHEET_HEADERS);
  sheet.setFrozenRows(1);
  formatSheet_(sheet);
  PropertiesService.getScriptProperties().setProperty('SHEET_ID', ss.getId());
  Logger.log('Sheet created: ' + ss.getUrl());
}

// For a sheet created by the older 8-column version: adds the two new
// headers and sets Date/Time/End Time to plain text. Safe to run more than once.
function migrateSheet() {
  const sheet = getSheet_();
  sheet.getRange(1, 1, 1, SHEET_HEADERS.length).setValues([SHEET_HEADERS]);
  formatSheet_(sheet);
  Logger.log('Sheet migrated.');
}

// Plain-text format stops Sheets from converting "10:30 AM" into a time value.
function formatSheet_(sheet) {
  sheet.getRange('F:G').setNumberFormat('@');
  sheet.getRange('J:J').setNumberFormat('@');
}

// ---------- SERVE THE PAGE ----------
function doGet() {
  return HtmlService.createHtmlOutputFromFile('index')
    .setTitle('Book an Appointment — ' + BRAND_NAME)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ---------- DATA FOR THE CLIENT ----------
function getServiceCatalog() {
  return SERVICE_CATALOG.map((sec, si) => ({
    section: sec.section,
    items: sec.items.map((it, ii) => ({
      id: si + '-' + ii,
      label: serviceLabel_(it),
      price: it.price,
      minutes: it.minutes,
      durationText: it.minutes ? formatDuration_(it.minutes) : ''
    }))
  }));
}

function getValidDates() {
  const dates = [];
  const today = new Date();
  const tz = tz_();
  for (let i = 0; i < BOOKING_WINDOW_DAYS; i++) {
    const d = new Date(today);
    d.setDate(today.getDate() + i);
    const dayName = Utilities.formatDate(d, tz, 'EEEE');
    if (!BUSINESS_HOURS[dayName]) continue;
    if (FIXED_HOLIDAYS.indexOf(Utilities.formatDate(d, tz, 'MM-dd')) !== -1) continue;
    if (ONE_OFF_CLOSURES.indexOf(Utilities.formatDate(d, tz, 'yyyy-MM-dd')) !== -1) continue;
    dates.push(dayName + ', ' + Utilities.formatDate(d, tz, 'MMMM d'));
  }
  return dates;
}

// Called whenever the date OR the selected services change.
function getTimesForDate(date, serviceIds) {
  const items = resolveServices_(serviceIds || []);
  if (!items || items.length === 0) return [];
  const data = getSheet_().getDataRange().getValues();
  return computeSlots_(date, totalMinutes_(items), data);
}

// ---------- SUBMIT WITH LOCKING ----------
function submitBooking(payload) {
  if (payload && payload.website) return { success: true }; // honeypot

  if (!payload || !payload.name || !payload.phone || !payload.email || !payload.date || !payload.time) {
    return { success: false, reason: 'invalid', message: 'Missing required fields.' };
  }
  const items = resolveServices_(payload.services);
  if (!items || items.length === 0) {
    return { success: false, reason: 'invalid', message: 'Please select at least one service.' };
  }
  if (getValidDates().indexOf(payload.date) === -1) {
    return { success: false, reason: 'invalid', message: 'That date is not available.' };
  }

  const duration = totalMinutes_(items);
  const startMins = timeToMinutes_(payload.time);
  const endTime = minutesToTime_(startMins + duration);
  const labels = items.map(serviceLabel_);
  const servicesStr = labels.join(', ');

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) {
    return { success: false, reason: 'busy', message: 'System is busy, please try again in a moment.' };
  }

  try {
    const sheet = getSheet_();
    const data = sheet.getDataRange().getValues();

    // Re-check INSIDE the lock: the start must be an offered slot and the
    // whole block (plus buffer) must still be free.
    const slot = computeSlots_(payload.date, duration, data).filter(s => s.time === payload.time)[0];
    if (!slot) {
      return { success: false, reason: 'conflict', message: 'That time no longer fits the selected services. Please pick another.' };
    }
    if (slot.booked) {
      return { success: false, reason: 'conflict', message: 'That time was just booked by someone else. Please pick another.' };
    }

    sheet.appendRow([
      new Date(), payload.name, payload.phone, payload.email, servicesStr,
      payload.date, payload.time, payload.notes || '', duration, endTime
    ]);

    const when = payload.date + ', ' + payload.time + ' – ' + endTime + ' (' + formatDuration_(duration) + ')';

    // Notify owner
    try {
      GmailApp.sendEmail(
        ownerEmail_(),
        'New Booking: ' + payload.date + ' at ' + payload.time,
        'Name: ' + payload.name + '\nPhone: ' + payload.phone + '\nEmail: ' + payload.email +
          '\nServices:\n  - ' + labels.join('\n  - ') +
          '\nWhen: ' + when +
          '\nNotes: ' + (payload.notes || 'None'),
        mailOpts_({ replyTo: payload.email, name: 'Beauty Method Booking System' })
      );
    } catch (err) {
      Logger.log('Owner notification email failed: ' + err.message);
    }

    // Salon calendar — event runs for the full service time (buffer not included)
    try {
      const times = parseBookingDateTime_(payload.date, payload.time, duration);
      const eventOptions = {
        description: 'Phone: ' + payload.phone + '\nEmail: ' + payload.email +
          '\nServices: ' + servicesStr +
          '\nDuration: ' + formatDuration_(duration) +
          '\nNotes: ' + (payload.notes || 'None')
      };
      if (INVITE_CLIENT_TO_CALENDAR) {
        eventOptions.guests = payload.email;
        eventOptions.sendInvites = true;
      }
      CalendarApp.getDefaultCalendar().createEvent(
        payload.name + ' — ' + items.map(i => i.name).join(', '), times.start, times.end, eventOptions
      );
    } catch (err) {
      Logger.log('Calendar event creation failed: ' + err.message);
    }

    // Client confirmation
    const support = supportEmail_();
    const serviceRows = items.map(it =>
      '<tr><td style="padding:4px 8px;text-align:left;">' + esc_(serviceLabel_(it)) + '</td>' +
      '<td style="padding:4px 8px;text-align:right;color:#777;white-space:nowrap;">' +
        (it.minutes ? formatDuration_(it.minutes) : '') + '</td></tr>'
    ).join('');

    const confirmHtml = '<div style="font-family:Georgia,serif;max-width:480px;margin:0 auto;text-align:center;">' +
      '<img src="cid:logo" alt="The Beauty Method" style="width:220px;margin-bottom:16px;">' +
      '<h2 style="color:' + EMAIL_ACCENT + ';font-family:Georgia,serif;">Booking Confirmed</h2>' +
      '<p>Hi ' + esc_(payload.name) + ',</p>' +
      '<p>Your appointment is confirmed for<br><strong>' + esc_(payload.date) + '</strong><br><strong>' +
        esc_(payload.time) + ' – ' + endTime + '</strong></p>' +
      '<table style="width:100%;border-collapse:collapse;margin:12px 0;font-size:15px;' +
        'border-top:1px solid #eab8d0;border-bottom:1px solid #eab8d0;">' + serviceRows +
      '<tr><td style="padding:8px;text-align:left;color:' + EMAIL_ACCENT + ';"><strong>Estimated total time</strong></td>' +
        '<td style="padding:8px;text-align:right;color:' + EMAIL_ACCENT + ';white-space:nowrap;"><strong>' + formatDuration_(duration) + '</strong></td></tr>' +
      '</table>' +
      '<p>See you then!<br>The Beauty Method</p>' +
      '<p style="font-size:13px;color:#777;margin-top:20px;">Need to cancel or reschedule, or have a question? Email us at ' +
        '<a href="mailto:' + support + '" style="color:' + EMAIL_ACCENT + ';">' + support + '</a>.</p>' +
      '</div>';

    const confirmText =
      'Your appointment is confirmed.\n\n' + when + '\n\nServices:\n  - ' + labels.join('\n  - ') +
      '\n\nNeed to cancel or reschedule? Email ' + support + '\n\n' + BRAND_NAME;

    try {
      GmailApp.sendEmail(
        payload.email,
        'Booking Confirmed — ' + BRAND_NAME,
        confirmText,
        mailOpts_({ replyTo: support, name: BRAND_NAME, htmlBody: confirmHtml, inlineImages: { logo: getLogoBlob_() } })
      );
    } catch (err) {
      Logger.log('Client confirmation email failed: ' + err.message);
      try {
        GmailApp.sendEmail(ownerEmail_(), 'ALERT: Client confirmation email failed',
          'A booking was saved but the confirmation email to the client failed to send.\n\n' +
          'Client: ' + payload.name + ' (' + payload.email + ')\n' +
          'When: ' + when + '\n\n' +
          'Error: ' + err.message + '\n\n' +
          'Please follow up with the client directly.',
          mailOpts_({}));
      } catch (alertErr) {
        Logger.log('Alert email also failed: ' + alertErr.message);
      }
    }

    return { success: true, endTime: endTime, duration: duration };
  } finally {
    lock.releaseLock();
  }
}

function getSheet_() {
  const sheetId = PropertiesService.getScriptProperties().getProperty('SHEET_ID');
  if (!sheetId) throw new Error('Run setupSheet first.');
  return SpreadsheetApp.openById(sheetId).getSheets()[0];
}
